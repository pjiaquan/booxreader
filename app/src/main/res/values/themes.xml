<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- =====================================================================
         BooxReader Design System — Core Themes
         All screens inherit the Material 3 color tokens defined here.
         ===================================================================== -->

    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="windowActionModeOverlay">true</item>
        <item name="actionModeStyle">@style/Widget.App.ActionMode</item>
        <item name="android:windowBackground">?attr/colorSurface</item>

        <!-- Material 3 color tokens -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_variant</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_container</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorOnBackground">@color/on_background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorSurfaceContainerLowest">@color/surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/surface_container_low</item>
        <item name="colorSurfaceContainer">@color/surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/surface_container_highest</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline_variant</item>
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/on_error</item>
        <item name="colorErrorContainer">@color/error_container</item>
        <item name="colorOnErrorContainer">@color/on_error_container</item>

        <!-- Default component styling -->
        <item name="materialButtonStyle">@style/Widget.App.Button.Primary</item>
        <item name="materialCardViewStyle">@style/Widget.App.Card</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="AppTheme.ActionBar" parent="Theme.MaterialComponents.DayNight">
        <item name="windowActionModeOverlay">true</item>
        <item name="actionModeStyle">@style/Widget.App.ActionMode</item>
        <item name="colorPrimary">@color/action_bar_surface</item>
        <item name="colorPrimaryVariant">@color/action_bar_surface</item>
        <item name="colorPrimaryDark">@color/action_bar_surface</item>
        <item name="colorOnPrimary">@color/action_bar_on_surface</item>
        <item name="colorControlNormal">@color/action_bar_on_surface</item>
        <item name="actionMenuTextColor">@color/action_bar_on_surface</item>
        <item name="android:statusBarColor">@color/action_bar_surface</item>
        <item name="android:windowBackground">?attr/colorSurface</item>
        <item name="materialButtonStyle">@style/Widget.App.Button.Primary</item>
        <item name="materialCardViewStyle">@style/Widget.App.Card</item>
        <!-- M3 attrs not present in the Theme.MaterialComponents (M2) parent.
             activity_user_profile.xml uses ?attr/colorOutlineVariant on card strokeColor
             and ?attr/colorOnSurfaceVariant on icon tints; define them explicitly. -->
        <item name="colorOutlineVariant">@color/outline_variant</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
    </style>

    <!-- ReaderSettingsActivity: Material3-based theme so Material3 attrs resolve on all API levels. -->
    <style name="AppTheme.ReaderSettings" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="windowActionModeOverlay">true</item>
        <item name="actionModeStyle">@style/Widget.App.ActionMode</item>
        <item name="colorPrimary">@color/action_bar_surface</item>
        <item name="colorOnPrimary">@color/action_bar_on_surface</item>
        <item name="colorControlNormal">@color/action_bar_on_surface</item>
        <item name="actionMenuTextColor">@color/action_bar_on_surface</item>
        <item name="android:statusBarColor">@color/action_bar_surface</item>
        <item name="android:windowBackground">?attr/colorSurface</item>
        <item name="materialButtonStyle">@style/Widget.App.Button.Primary</item>
        <item name="materialCardViewStyle">@style/Widget.App.Card</item>
    </style>

    <style name="AppTheme.ActionBar.AiNoteDetail" parent="AppTheme.ActionBar">
        <item name="colorPrimary">@color/ai_note_top_bar</item>
        <item name="colorPrimaryVariant">@color/ai_note_top_bar</item>
        <item name="colorPrimaryDark">@color/ai_note_top_bar</item>
        <item name="android:statusBarColor">@color/ai_note_top_bar</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- =====================================================================
         Shared Component Styles
         ===================================================================== -->

    <!-- Modernist Switch Style (Square Toggle) -->
    <style name="Widget.App.Switch.Modernist" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="track">@drawable/switch_track_modernist</item>
        <item name="android:thumb">@drawable/switch_thumb_modernist</item>
        <item name="thumbTint">@null</item>
        <item name="trackTint">@null</item>
        <item name="showText">false</item>
        <item name="android:switchMinWidth">44dp</item>
        <item name="android:switchPadding">8dp</item>
    </style>

    <!-- Primary filled button: 52dp height, 0dp radius, red fill, left aligned -->
    <style name="Widget.App.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">@dimen/settings_button_height</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="cornerRadius">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
    </style>

    <!-- Centered primary button variant when needed -->
    <style name="Widget.App.Button.Primary.Center" parent="Widget.App.Button.Primary">
        <item name="android:gravity">center</item>
    </style>

    <!-- Outlined button: 52dp height, 0dp radius, 2dp border -->
    <style name="Widget.App.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/settings_button_height</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">0dp</item>
        <item name="strokeWidth">2dp</item>
        <item name="strokeColor">?attr/colorOnSurface</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- Text button -->
    <style name="Widget.App.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="cornerRadius">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- Card: flat, 0dp radius, 1dp/2dp architectural borders -->
    <style name="Widget.App.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">0dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="strokeColor">@color/divider_major</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Outlined / Underline text field styles -->
    <style name="Widget.App.TextInputLayout.Outlined" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/primary</item>
        <item name="hintTextColor">@color/primary</item>
        <item name="startIconTint">?attr/colorOnSurfaceVariant</item>
        <item name="boxCornerRadiusTopStart">0dp</item>
        <item name="boxCornerRadiusTopEnd">0dp</item>
        <item name="boxCornerRadiusBottomStart">0dp</item>
        <item name="boxCornerRadiusBottomEnd">0dp</item>
        <item name="boxBackgroundColor">?attr/colorSurface</item>
        <item name="android:textColorHint">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Widget.App.TextInputLayout.Underline" parent="Widget.MaterialComponents.TextInputLayout.FilledBox">
        <item name="boxBackgroundMode">filled</item>
        <item name="boxBackgroundColor">@android:color/transparent</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="boxStrokeColor">@color/primary</item>
        <item name="hintTextColor">@color/primary</item>
        <item name="startIconTint">?attr/colorOnSurfaceVariant</item>
        <item name="android:textColorHint">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Section label above grouped content (Modernist kicker: 10sp, 700, ALL CAPS) -->
    <style name="TextAppearance.App.SectionLabel" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.12</item>
    </style>

    <!-- Nav header title: 18sp, 700 weight (design spec: Screen title) -->
    <style name="TextAppearance.App.NavHeader" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Card title -->
    <style name="TextAppearance.App.CardTitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- Settings row label -->
    <style name="TextAppearance.App.SettingRow" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- Hint / secondary text -->
    <style name="TextAppearance.App.Hint" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Widget.App.ActionMode" parent="Widget.AppCompat.ActionMode">
        <item name="background">@color/action_bar_surface</item>
        <item name="titleTextStyle">@style/TextAppearance.App.ActionMode.Title</item>
        <item name="subtitleTextStyle">@style/TextAppearance.App.ActionMode.Subtitle</item>
    </style>

    <style name="TextAppearance.App.ActionMode.Title" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textColor">@color/action_bar_on_surface</item>
    </style>

    <style name="TextAppearance.App.ActionMode.Subtitle" parent="TextAppearance.AppCompat.Widget.ActionBar.Subtitle">
        <item name="android:textColor">@color/action_bar_on_surface</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#FFFFFF">

    <TextView
        android:id="@+id/tvDetailQuote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="5"
        android:ellipsize="end"
        android:textSize="15sp"
        android:textStyle="italic"
        android:textColor="#333333"
        android:padding="10dp"
        android:background="#F0F0F0"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvDetailNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textColor="#000000"
        android:layout_marginBottom="16dp"
        android:visibility="gone" />

    <RadioGroup
        android:id="@+id/rgDetailStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <RadioButton
            android:id="@+id/rbDetailUnderline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/annotation_style_underline" />

        <RadioButton
            android:id="@+id/rbDetailDashed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/annotation_style_dashed" />

        <RadioButton
            android:id="@+id/rbDetailGrayFill"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/annotation_style_gray_fill" />
    </RadioGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnDetailDelete"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/annotation_delete"
            android:textColor="#D32F2F"
            style="?android:attr/borderlessButtonStyle" />

        <Button
            android:id="@+id/btnDetailEditNote"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/annotation_note_edit_title"
            android:textColor="#333333"
            style="?android:attr/borderlessButtonStyle" />

    </LinearLayout>

</LinearLayout>

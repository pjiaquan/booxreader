<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    tools:context=".ui.welcome.WelcomeActivity">

    <!-- Top Illustration Area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="228dp"
        android:background="@color/subtle_fill">

        <ImageView
            android:id="@+id/ivIcon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_menu_book"
            app:tint="@color/text_tertiary" />
    </FrameLayout>

    <!-- Content + CTA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingTop="30dp"
        android:paddingEnd="32dp"
        android:paddingBottom="44dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/text_tertiary"
            android:textAllCaps="true"
            android:letterSpacing="0.18"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/welcome_title"
            android:textSize="38sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:lineSpacingMultiplier="1.05"
            android:layout_marginBottom="14dp" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:text="@string/welcome_subtitle"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:lineSpacingMultiplier="1.7" />

        <Button
            android:id="@+id/btnGrant"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/welcome_grant_button"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnSkip"
            style="@style/Widget.App.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/welcome_skip_button"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>

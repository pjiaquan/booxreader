<?xml version="1.0" encoding="utf-8"?>
<!--
    Reader Settings content — Modernist redesign (handoff screen 1g / 3g).
    Flat surfaces, 0dp radius, 2dp/1dp architectural rules, square toggles,
    ALL-CAPS section kickers, 52dp rows. All runtime colors (text, dividers,
    backgrounds) are re-applied per selected reading theme by
    ReaderSettingsActivity.applySettingsPageTheme().
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settingsScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/settingsMainContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ======================= 1. READING & DISPLAY ======================= -->
        <TextView
            style="@style/TextAppearance.App.SectionLabel"
            android:layout_width="wrap_content"
            android:tag="section_label"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"
            android:text="@string/reader_settings_cat_reading" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_major" />

        <!-- Reading Theme — 2x2 grid of 40dp square theme buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnThemeNormal"
                    style="@style/Widget.App.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="40dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/reader_settings_theme_normal"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="8dp"
                    android:layout_height="wrap_content" />

                <Button
                    android:id="@+id/btnThemeDark"
                    style="@style/Widget.App.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="40dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/reader_settings_theme_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Space
                android:layout_width="wrap_content"
                android:layout_height="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnThemeSepia"
                    style="@style/Widget.App.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="40dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/reader_settings_theme_sepia"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="8dp"
                    android:layout_height="wrap_content" />

                <Button
                    android:id="@+id/btnThemeHighContrast"
                    style="@style/Widget.App.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="40dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/reader_settings_theme_high_contrast"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/divider_major" />

        <!-- Font Size row: label + custom 2dp slider + value -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <TextView
                style="@style/TextAppearance.App.SettingRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reader_settings_font_size" />

            <SeekBar
                android:id="@+id/seekBarTextSize"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:max="250"
                android:progress="90"
                android:minHeight="24dp"
                android:progressDrawable="@drawable/bg_seekbar_progress"
                android:thumb="@drawable/bg_seekbar_thumb"
                android:progressTint="@color/text_primary"
                android:progressBackgroundTint="@color/divider_major" />

            <TextView
                android:id="@+id/tvTextSizeValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="140%"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/divider_major" />

        <!-- Tap to Turn Page -->
        <LinearLayout
            android:id="@+id/rowPageTap"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <TextView
                style="@style/TextAppearance.App.SettingRow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/reader_settings_tap_to_turn" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchPageTap"
                style="@style/Widget.App.Switch.Modernist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_major" />

        <!-- Swipe to Turn -->
        <LinearLayout
            android:id="@+id/rowPageSwipe"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <TextView
                style="@style/TextAppearance.App.SettingRow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/reader_settings_swipe_to_turn" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchPageSwipe"
                style="@style/Widget.App.Switch.Modernist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_major" />

        <!-- Page Animation -->
        <LinearLayout
            android:id="@+id/rowPageAnimation"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <TextView
                style="@style/TextAppearance.App.SettingRow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/reader_settings_page_animation" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchPageAnimation"
                style="@style/Widget.App.Switch.Modernist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_major" />

        <!-- Show Page Indicator -->
        <LinearLayout
            android:id="@+id/rowPageIndicator"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <TextView
                style="@style/TextAppearance.App.SettingRow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/reader_settings_show_page_indicator" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchPageIndicator"
                style="@style/Widget.App.Switch.Modernist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_major" />

        <!-- Simplified -> Traditional -->
        <LinearLayout
            android:id="@+id/rowConvertChinese"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <TextView
                style="@style/TextAppearance.App.SettingRow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/reader_settings_convert_chinese" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchConvertChinese"
                style="@style/Widget.App.Switch.Modernist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- ======================= 2. LANGUAGE ======================= -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/divider_major" />

        <TextView
            style="@style/TextAppearance.App.SectionLabel"
            android:layout_width="wrap_content"
            android:tag="section_label"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"
            android:text="@string/reader_settings_language_title" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_major" />

        <!-- System Default -->
        <LinearLayout
            android:id="@+id/rowLangSystem"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <TextView
                style="@style/TextAppearance.App.SettingRow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/reader_settings_lang_system" />

            <ImageView
                android:id="@+id/ivCheckLangSystem"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/reader_settings_lang_selected"
                android:src="@drawable/ic_check_24"
                android:tag="check_icon"
                android:tint="@color/text_primary" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_major" />

        <!-- English -->
        <LinearLayout
            android:id="@+id/rowLangEnglish"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <TextView
                style="@style/TextAppearance.App.SettingRow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/reader_settings_lang_english" />

            <ImageView
                android:id="@+id/ivCheckLangEnglish"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/reader_settings_lang_selected"
                android:src="@drawable/ic_check_24"
                android:tag="check_icon"
                android:tint="@color/text_primary"
                android:visibility="gone" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_major" />

        <!-- Chinese -->
        <LinearLayout
            android:id="@+id/rowLangChinese"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <TextView
                style="@style/TextAppearance.App.SettingRow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/reader_settings_lang_chinese" />

            <ImageView
                android:id="@+id/ivCheckLangChinese"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/reader_settings_lang_selected"
                android:src="@drawable/ic_check_24"
                android:tag="check_icon"
                android:tint="@color/text_primary"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ======================= 3. AI & CLOUD SYNC ======================= -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/divider_major" />

        <TextView
            style="@style/TextAppearance.App.SectionLabel"
            android:layout_width="wrap_content"
            android:tag="section_label"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"
            android:text="@string/reader_settings_cat_ai_cloud" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_major" />

        <!-- AI Profiles -->
        <Button
            android:id="@+id/btnAiProfiles"
            style="@style/Widget.App.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:gravity="start|center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="@string/reader_settings_ai_profiles"
            android:textAllCaps="false" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_major" />

        <!-- Manage Magic Tags -->
        <Button
            android:id="@+id/btnManageMagicTags"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:text="@string/action_manage_magic_tags"
            android:textAllCaps="false" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_major" />

        <!-- Server URL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="12dp"
            android:paddingEnd="24dp"
            android:paddingBottom="12dp">

            <TextView
                style="@style/TextAppearance.App.SectionLabel"
                android:layout_width="wrap_content"
                android:tag="section_label"
                android:layout_height="wrap_content"
                android:paddingBottom="4dp"
                android:text="@string/reader_settings_server_url" />

            <EditText
                android:id="@+id/etServerUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_underline"
                android:hint="@string/reader_settings_server_url_hint"
                android:inputType="textUri"
                android:minHeight="40dp"
                android:paddingStart="0dp"
                android:paddingTop="8dp"
                android:paddingEnd="0dp"
                android:paddingBottom="8dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:textSize="16sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_major" />

        <!-- API Key -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="12dp"
            android:paddingEnd="24dp"
            android:paddingBottom="12dp">

            <TextView
                style="@style/TextAppearance.App.SectionLabel"
                android:layout_width="wrap_content"
                android:tag="section_label"
                android:layout_height="wrap_content"
                android:paddingBottom="4dp"
                android:text="@string/reader_settings_api_key" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.App.TextInputLayout.Underline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etApiKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="password"
                    android:hint="@string/reader_settings_api_key_hint"
                    android:inputType="textPassword"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_tertiary"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- ======================= 4. DAILY READING DIGEST ======================= -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/divider_major" />

        <TextView
            style="@style/TextAppearance.App.SectionLabel"
            android:layout_width="wrap_content"
            android:tag="section_label"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"
            android:text="@string/reader_settings_cat_daily" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_major" />

        <!-- Enable daily email -->
        <LinearLayout
            android:id="@+id/rowDailySummaryEmail"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <TextView
                style="@style/TextAppearance.App.SettingRow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/reader_settings_daily_email_enable" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchDailySummaryEmail"
                style="@style/Widget.App.Switch.Modernist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_major" />

        <!-- Send time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <TextView
                style="@style/TextAppearance.App.SettingRow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/reader_settings_daily_email_time_label" />

            <TextView
                android:id="@+id/tvDailySummaryTimeValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:text="21:00"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnDailySummaryPickTime"
                style="@style/Widget.App.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:text="@string/reader_settings_daily_email_pick_time"
                android:textAllCaps="false" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_major" />

        <!-- Recipient email -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="12dp"
            android:paddingEnd="24dp"
            android:paddingBottom="12dp">

            <TextView
                style="@style/TextAppearance.App.SectionLabel"
                android:layout_width="wrap_content"
                android:tag="section_label"
                android:layout_height="wrap_content"
                android:paddingBottom="4dp"
                android:text="@string/reader_settings_daily_email_to_label" />

            <EditText
                android:id="@+id/etDailySummaryEmailTo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="emailAddress"
                android:background="@drawable/bg_input_underline"
                android:hint="@string/reader_settings_daily_email_to_hint"
                android:inputType="textEmailAddress"
                android:minHeight="40dp"
                android:paddingStart="0dp"
                android:paddingTop="8dp"
                android:paddingEnd="0dp"
                android:paddingBottom="8dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- ======================= 5. BOOKMARKS & EXPORT ======================= -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/divider_major" />

        <TextView
            style="@style/TextAppearance.App.SectionLabel"
            android:layout_width="wrap_content"
            android:tag="section_label"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"
            android:text="@string/reader_settings_cat_bookmarks_export" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_major" />

        <!-- Add Bookmark / View Bookmarks -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingTop="8dp"
            android:paddingEnd="24dp"
            android:paddingBottom="8dp">

            <Button
                android:id="@+id/btnSettingsAddBookmark"
                style="@style/Widget.App.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="52dp"
                android:text="@string/reader_settings_add_bookmark"
                android:textAllCaps="false" />

            <Space
                android:layout_width="12dp"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btnSettingsShowBookmarks"
                style="@style/Widget.App.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="52dp"
                android:text="@string/reader_settings_view_bookmark"
                android:textAllCaps="false" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_major" />

        <!-- Use custom export URL -->
        <LinearLayout
            android:id="@+id/rowCustomExport"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <TextView
                style="@style/TextAppearance.App.SettingRow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/reader_settings_custom_export_checkbox" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/cbCustomExportUrl"
                style="@style/Widget.App.Switch.Modernist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_major" />

        <!-- Custom export URL input -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="12dp"
            android:paddingEnd="24dp"
            android:paddingBottom="12dp">

            <TextView
                style="@style/TextAppearance.App.SectionLabel"
                android:layout_width="wrap_content"
                android:tag="section_label"
                android:layout_height="wrap_content"
                android:paddingBottom="4dp"
                android:text="@string/reader_settings_custom_export_label" />

            <EditText
                android:id="@+id/etCustomExportUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_underline"
                android:enabled="false"
                android:hint="@string/reader_settings_custom_export_hint"
                android:inputType="textUri"
                android:minHeight="40dp"
                android:paddingStart="0dp"
                android:paddingTop="8dp"
                android:paddingEnd="0dp"
                android:paddingBottom="8dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:textSize="16sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_major" />

        <!-- Save AI notes to Downloads -->
        <LinearLayout
            android:id="@+id/rowLocalExport"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <TextView
                style="@style/TextAppearance.App.SettingRow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/reader_settings_local_export_checkbox" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/cbLocalExport"
                style="@style/Widget.App.Switch.Modernist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_major" />

        <!-- Test export endpoint -->
        <Button
            android:id="@+id/btnTestExportEndpoint"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="8dp"
            android:minHeight="52dp"
            android:text="@string/reader_settings_test_export"
            android:textAllCaps="false" />

        <!-- ======================= 6. ACCOUNT ======================= -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/divider_major" />

        <TextView
            style="@style/TextAppearance.App.SectionLabel"
            android:layout_width="wrap_content"
            android:tag="section_label"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"
            android:text="@string/reader_settings_cat_account" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_major" />

        <!-- User Profile -->
        <Button
            android:id="@+id/btnUserProfile"
            style="@style/Widget.App.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:gravity="start|center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="@string/reader_settings_user_profile"
            android:textAllCaps="false" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_major" />

        <!-- Auto-check for updates -->
        <LinearLayout
            android:id="@+id/rowAutoCheckUpdates"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <TextView
                style="@style/TextAppearance.App.SettingRow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/reader_settings_auto_check_updates" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchAutoCheckUpdates"
                style="@style/Widget.App.Switch.Modernist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/divider_major" />

        <!-- App Version Footer -->
        <TextView
            android:id="@+id/tvAppVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="32dp"
            android:gravity="center"
            android:text="BooxReader"
            android:textColor="@color/text_quaternary"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>

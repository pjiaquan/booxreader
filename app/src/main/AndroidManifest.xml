<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      Storage permissions for EPUB file download and access.
      Android 13+ 不需要任何媒體權限：EPUB 一律經由 SAF (content://) 或 App 專屬目錄存取，
      而 MediaStore 下載在 API 29+ 也不需要權限。因此不宣告 READ_MEDIA_IMAGES。
    -->
    <!-- For Android 12 and below -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" /> <!-- Only needed for Android 9 and below -->

    <!-- For app-specific storage (no permission needed for Android 10+) -->
    <!-- App can write to its own directories without permission -->

    <application
        android:name="my.hinoki.booxreader.BooxReaderApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="31">
        <activity
            android:name="my.hinoki.booxreader.ui.welcome.WelcomeActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Material3.DayNight.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="my.hinoki.booxreader.ui.main.MainActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.Material3.DayNight.NoActionBar" />

        <activity
            android:name="my.hinoki.booxreader.ui.reader.ReaderActivity"
            android:theme="@style/Theme.Material3.DayNight.NoActionBar"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|fontScale"
            android:exported="false" />

        <activity
            android:name="my.hinoki.booxreader.ui.reader.ReaderSettingsActivity"
            android:exported="false"
            android:theme="@style/AppTheme.ReaderSettings"
            android:label="@string/reader_settings_title" />


        <activity
            android:name="my.hinoki.booxreader.ui.bookmarks.BookmarkListActivity"
            android:exported="false" />

        <activity
            android:name="my.hinoki.booxreader.ui.notes.AiNoteListActivity"
            android:exported="false"
            android:theme="@style/AppTheme"
            android:label="@string/ai_notes_title" />

        <activity
            android:name="my.hinoki.booxreader.ui.notes.AiNoteDetailActivity"
            android:exported="false"
            android:theme="@style/AppTheme.ActionBar.AiNoteDetail"
            android:windowSoftInputMode="adjustResize"
            android:label="@string/ai_note_details_title" />

        <activity
            android:name="my.hinoki.booxreader.ui.auth.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:label="@string/login_title" />

        <activity
            android:name="my.hinoki.booxreader.ui.auth.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:label="@string/register_title" />

        <activity
            android:name="my.hinoki.booxreader.ui.auth.UserProfileActivity"
            android:exported="false"
            android:label="@string/reader_settings_user_profile"
            android:theme="@style/AppTheme.ActionBar" />

        <activity
            android:name="my.hinoki.booxreader.ui.settings.AiProfileListActivity"
            android:exported="false"
            android:label="@string/reader_settings_ai_profiles"
            android:theme="@style/AppTheme.ActionBar" />

        <activity
            android:name="my.hinoki.booxreader.ui.settings.AiProfileEditActivity"
            android:exported="false"
            android:label="@string/ai_profile_edit_title"
            android:theme="@style/Theme.Material3.DayNight.NoActionBar" />

        <activity
            android:name="my.hinoki.booxreader.ui.settings.MagicTagListActivity"
            android:exported="false"
            android:label="@string/magic_tag_title"
            android:theme="@style/AppTheme.ActionBar" />

        <!-- FileProvider for secure file sharing -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
